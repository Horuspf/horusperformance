    .step-num{font-size:2.8rem;width:48px}.step-title{font-size:1.15rem;margin-bottom:4px}.step-desc{font-size:.85rem;color:var(--silver);line-height:1.5;font-weight:300}
    .urgency-text{font-size:clamp(1.6rem,6vw,2.8rem);color:var(--white);line-height:1.15;margin-bottom:16px}

