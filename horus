    .author-name{font-family:"Barlow Condensed",Arial,sans-serif;font-weight:700;font-size:.9rem;text-transform:uppercase;letter-spacing:.05em;color:var(--white)}
    .author-role{font-size:.72rem;color:var(--silver);font-weight:300}
    .testi-badge{font-family:"Barlow Condensed",Arial,sans-serif;font-weight:700;font-size:.6rem;text-transform:uppercase;letter-spacing:.12em;padding:2px 8px;border-radius:2px;display:inline-block;margin-bottom:10px}
    .tb-odonto{background:rgba(100,180,255,.13);color:#64b4ff}
    .tb-med{background:rgba(100,255,180,.13);color:#4ade9a}
    .tb-estetica{background:rgba(255,180,220,.13);color:#ffaad4}
