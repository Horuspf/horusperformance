    .reveal,.reveal-left,.reveal-right,.reveal-scale{opacity:0;filter:blur(6px);transition:opacity .9s cubic-bezier(.22,1,.36,1),transform .9s cubic-bezier(.22,1,.36,1),filter .9s cubic-bezier(.22,1,.36,1)}
    .reveal{transform:translateY(54px)}.reveal-left{transform:translateX(-54px)}.reveal-right{transform:translateX(54px)}.reveal-scale{transform:translateY(34px) scale(.94)}
    .reveal.visible,.reveal-left.visible,.reveal-right.visible,.reveal-scale.visible{opacity:1;filter:blur(0);transform:none}
